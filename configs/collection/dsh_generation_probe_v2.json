{
  "schema_version": 2,
  "contract_id": "dsh-generation-probe-v2",
  "source_id": "dsh_session_probe_v2",
  "sidecar_filename": "generation-probe.jsonl",
  "session_capture_fields": [
    "capture_revision"
  ],
  "session_model_fields": [
    "model_id",
    "model_revision"
  ],
  "join_key": [
    "session_id",
    "attempt_id",
    "checkpoint_ordinal",
    "observer_committed_tokens"
  ],
  "projection": {
    "policy_id": "rademacher-last-layer-v2",
    "policy_version": 2,
    "source_layer": "last",
    "dimension": 64,
    "seed": 729,
    "hidden_size": {
      "type": "integer",
      "minimum": 1,
      "source": "runtime_model_config"
    },
    "distribution": "rademacher",
    "scaling": "inverse_sqrt_hidden_size",
    "dtype": "float32",
    "rng_algorithm": "torch-cpu-generator-v1",
    "fit_scope": "fixed_without_dataset_fit"
  },
  "checkpoint_payload_additions": [
    "hidden_state_projection",
    "source_output_tokens"
  ],
  "forbidden_sidecar_fields": [
    "label",
    "target",
    "final_output_tokens",
    "remaining_tokens",
    "task_terminal"
  ],
  "causal_alignment": "post_source_output_token_prefix_before_next_sample"
}
