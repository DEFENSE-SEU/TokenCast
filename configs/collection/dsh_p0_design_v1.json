  "difficulty_strata": [
   "low",
   "medium",
   "high"
  ],
  "difficulty_policy_id": "static-pre-execution-vector-v1",
  "vector_fields": {
   "components": "named components or interfaces involved",
   "requirements": "independently testable requirements in the frozen task",
   "input_families": "distinct input families visible at launch",
   "deliverable_kinds": "code, data, or report artifact kinds requested",
   "coordination_burden": "0 one localized surface, 1 several named interfaces or artifacts, 2 cross-component or cross-source coordination"
  },
  "strata": {
   "low": "components<=2, requirements<=3, input_families<=2, deliverable_kinds<=2, coordination_burden<=1",
   "medium": "3<=components<=4, 4<=requirements<=6, 3<=input_families<=4, 1<=deliverable_kinds<=3, coordination_burden=1",
   "high": "components>=5, requirements>=7, input_families>=5, deliverable_kinds>=2, coordination_burden=2"
  }
 },
 "repeat_ids": [
  "r0"
 ],
 "runtime": {
