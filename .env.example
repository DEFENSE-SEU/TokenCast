# Copy this file to .env and pass --env-file .env to the collector.

# Choose the connection profile here; model IDs come from --manifest.
MODEL_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Claude requires an OpenAI-compatible Chat Completions gateway.
CLAUDE_API_KEY=
CLAUDE_BASE_URL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Set the endpoint's actual limits; the output ceiling must cover the manifest cap.
MODEL_CONTEXT_WINDOW=131072
MODEL_MAX_OUTPUT_TOKENS=65536

# For openai-codex, optionally set an auth.json path; otherwise CODEX_HOME or ~/.codex is used.
OPENAI_CODEX_AUTH_FILE=
